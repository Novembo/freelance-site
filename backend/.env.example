# Copie ce fichier en ".env" (ou configure ces variables dans l'interface
# de ton hébergeur — Railway, Render, etc.) et remplis les vraies valeurs.
# Ne commite JAMAIS le fichier ".env" lui-même sur GitHub.

KKIAPAY_PUBLIC_KEY=
KKIAPAY_PRIVATE_KEY=
KKIAPAY_SECRET_KEY=
KKIAPAY_SANDBOX=true

# Jeton secret que toi seul connais, pour accéder aux endpoints /api/admin/...
# Génère-le avec : python -c "import secrets; print(secrets.token_urlsafe(32))"
ADMIN_TOKEN=

# Origines autorisées à appeler l'API (séparées par des virgules).
# En production : l'URL exacte du site, sans slash final.
ALLOWED_ORIGINS=http://127.0.0.1:8000,http://localhost:8000

# Emplacement de la base SQLite. En production, un volume persistant (ex. /data/site.db).
# Laisser vide en local : backend/data/site.db est utilisé.
DB_PATH=
